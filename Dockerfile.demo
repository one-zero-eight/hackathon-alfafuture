FROM node:22-bookworm-slim AS ui
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ .
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY mock_server/requirements.txt /tmp/mock-requirements.txt
RUN pip install --no-cache-dir -r /tmp/mock-requirements.txt
COPY mock_server ./mock_server
COPY reasoning ./reasoning
COPY --from=ui /ui/dist ./ui/dist
ENV DEMO_COMPANY=U_9250
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "main:app", "--app-dir", "mock_server", "--host", "0.0.0.0", "--port", "8000"]
