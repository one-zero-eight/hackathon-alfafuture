# Copy to .env in the working directory for a run without Docker (docker/compose.yaml sets these itself).
# ENV_FILE can point to another file. Do not commit credentials or log DATABASE_URL.
DATABASE_URL=postgres://news:change-me@localhost:5432/news?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
# Built-in full-text collectors: RBC, Kommersant, CBR
POLL_INTERVAL=10m
FETCH_TIMEOUT=30s
FETCH_MAX_MB=8
RBC_FEED_URL=https://rssexport.rbc.ru/rbcnews/news/30/full.rss
KOMMERSANT_FEED_URL=https://www.kommersant.ru/RSS/news.xml
CBR_FEED_URL=https://www.cbr.ru/rss/eventrss
# Curated list of ~390 outlets and Google News topics
SOURCES_FILE=sources.json
TOPICS_FILE=topics.txt
FEEDS_EVERY=15m
DEEP_EVERY=6h
# Tagging and regional geotags (Gemma); LLM_ENABLED=false collects without spending
LLM_ENABLED=true
LLM_TIMEOUT=2m
LLM_API_KEY=
LLM_MODEL=google/gemma-4-26b-a4b-it
