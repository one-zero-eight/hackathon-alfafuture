# Copy to v1/.env. Use a URL-safe password (letters/digits): it goes into both URLs.
POSTGRES_PASSWORD=change-me
# Host-side URL for ingest.py and pipeline.py (the news container builds its own from POSTGRES_PASSWORD)
DATABASE_URL=postgres://news:change-me@127.0.0.1:5433/news?sslmode=disable
# LLM_API_KEY / LLM_BASE_URL(/_BACKUP) for pipeline.py: also read from the repo-root .env
