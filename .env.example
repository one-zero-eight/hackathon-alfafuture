# Copy to .env (gitignored) in the repository root. Compose reads it with --env-file.
POSTGRES_PASSWORD=change-me
LLM_API_KEY=
LLM_BASE_URL=
LLM_BASE_URL_BACKUP=
# Optional
# Tagging sends the whole tag vocabulary (~57k tokens) per article: expensive. false = the collector only collects.
LLM_ENABLED=true
NEWS_SEARCH_METHOD=dense_xquad

# Enable only after confirming gateway currency and available daily LLM budget.
TRACE_AI_ENABLED=false
