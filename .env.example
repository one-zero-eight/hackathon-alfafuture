# Copy to .env (gitignored) in the repository root. Compose reads it with --env-file.
# Only LLM_API_KEY is left empty; every other value works as is.
POSTGRES_PASSWORD=change-me
LLM_API_KEY=
# Organizer gateways: the primary, and a backup tried when the primary fails (agents) or is unset (collector).
LLM_BASE_URL=https://api.alfahack-gateway26.ru/v1
LLM_BASE_URL_BACKUP=https://changellenge.up.railway.app/v1
# Organizer-approved model IDs (only these are accepted):
#   google/gemma-4-26b-a4b-it, z-ai/glm-5.3-flash, qwen/qwen3.6-35b-a3b,
#   deepseek/deepseek-v4.1-flash, qwen/qwen3-vl-30b-a3b-instruct, moonshotai/kimi-k2.6
# Model of the collector's tagging and geotags.
COLLECTOR_LLM_MODEL=google/gemma-4-26b-a4b-it
# Tagging sends the whole tag vocabulary (~57k tokens) per article: expensive. false = the collector only collects.
LLM_ENABLED=true
TAGGING_ENABLED=true
GEOTAG_ENABLED=true
# lexical | dense_llm | dense_xquad
NEWS_SEARCH_METHOD=dense_xquad
NEWS_SEARCH_EMBED_EVERY=900
# Agents: also append the full call log (prompts, reasoning, answers) to this file; stdout always gets it
# AGENTS_LOG_FILE=
