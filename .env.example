# Docker Compose reads the root .env; backend/.env is for native Go runs.
# Choose a database password and put the same password, URL-encoded, in DATABASE_URL.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://news:change-me@postgres:5432/news?sslmode=disable
# Set the organizer-issued key locally; do not commit credentials.
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
