# Denylist: everything is tracked except caches, environments, build output and secrets.
# Rule of thumb: generated or machine-local => ignored here, so no section needs its own .gitignore.

# secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key

# python: environments, caches, build output
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
build/
dist/

# node / frontend
node_modules/
frontend/dist/
.vite/
*.tsbuildinfo
npm-debug.log*
.npm/

# go
*.test
*.out
/collector/bin/
coverage.txt

# docker
docker-compose.override.yaml
compose.override.yaml

# generated by the sections at run time
analytics/data/theses.jsonl
analytics/data/alfa-cache.jsonl
analytics/data/pages/
news_search/data/
*.npz

# database dumps (any kind)
dumps/
*.dump
*.pgdump
*.backup
*.bak
*.sql.gz
*.sql.zst
*.sql.bz2
*.dmp

# logs, databases, temporary files
*.log
*.db
*.sqlite3
tmp/
*.tmp
*.swp

# editors and OS
.idea/
.vscode/
.zed/
.DS_Store
Thumbs.db

# agent tool state
.claude/
agents_memory/
.run/
