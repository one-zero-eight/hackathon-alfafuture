# Allowlist: ignore everything by default, then allow project files.
# Keep directories traversable so Git can evaluate rules for their contents.
*
!*/

# --- allowlist ---

# git and project documentation and presenation
!.gitignore
!.gitattributes
!*.md
!docs/**
!LICENSE
!alfa-hack-presentation.pdf

# Go
!*.go
!go.mod
!go.sum

# Python
!*.py
!pyproject.toml
!uv.lock

# frontend
!*.js
!*.jsx
!*.mjs
!*.ts
!*.tsx
!*.html
!*.css
!package.json
!package-lock.json
!tsconfig*.json

# configuration and scripts
!*.yaml
!*.yml
!*.toml
!*.json
!.env.example
!Dockerfile
!Dockerfile.*
!*.Dockerfile
!.dockerignore
!*.sql
!*.sh
!/collector/topics.txt
!/docker/nginx.conf

# Organizer materials are part of the current project.
!/external-docs/**

# --- re-ignore: generated or machine-local files always stay ignored ---

# secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key

# python: environments, caches, build output
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
build/
dist/

# node / frontend
node_modules/
frontend/dist/
.vite/
*.tsbuildinfo
npm-debug.log*
.npm/

# go
*.test
*.out
/collector/bin/
coverage.txt

# docker
docker-compose.override.yaml
compose.override.yaml

# generated by the sections at run time
data/
analytics/data/theses.jsonl
analytics/data/alfa-cache.jsonl
analytics/data/pages/
news_search/data/
*.npz

# database dumps (any kind)
dumps/
*.dump
*.pgdump
*.backup
*.bak
*.sql.gz
*.sql.zst
*.sql.bz2
*.dmp

# logs, databases, temporary files
*.log
*.db
*.sqlite3
tmp/
*.tmp
*.swp

# editors and OS
.idea/
.vscode/
.zed/
.DS_Store
Thumbs.db

# agent tool state
backlog/
.claude/
agents_memory/
.run/

# Fixed vocabulary and role data are source files, not runtime data.
!/collector/internal/news/vocabulary/data/
!/collector/internal/news/vocabulary/data/v1.json
!/collector/internal/news/vocabulary/data/reference-data/
!/collector/internal/news/vocabulary/data/reference-data/geography-2026-10-21.json
!/analytics/data/
!/analytics/data/roles.json
