# Allowlist-style: ignore everything by default, then explicitly un-ignore what's meant to be
# tracked. Order matters — later rules win, so re-ignores must come after the allowlist.

# ignore everything by default, but allow descending into directories to evaluate their contents
*
!*/

# --- allowlist ---

# git
!.gitignore
!.gitattributes

# project markdown (AGENTS.md, README.md, docs)
!*.md
!docs/**

# license
!LICENSE

# Go backend
!*.go
!go.mod
!go.sum

# python (LLM / parsing / graph services)
!*.py
!pyproject.toml
!requirements*.txt
!uv.lock

# frontend
!*.js
!*.jsx
!*.mjs
!*.ts
!*.tsx
!*.html
!*.css
!package.json
!package-lock.json
!tsconfig*.json

# configs
!*.yaml
!*.yml
!*.toml
!*.json
!.env.example
!Dockerfile
!Dockerfile.*
!.dockerignore
!**/.dockerignore

# sql, shell
!*.sql
!*.sh

# --- re-ignore: never tracked, even if matched above ---

# hackathon materials, transcripts, meeting notes — local only
external-docs/

# personal agent state
backlog/
agents_memory/
.claude/

# junk / scratch / data
.DS_Store
.env
tmp/
node_modules/
.venv/
venv/
__pycache__/
dist/
build/
*.log
data/

# v1: copy of the Go service vocabulary, corpus topics, nginx config
!v1/backend/internal/news/vocabulary/data/
!v1/backend/internal/news/vocabulary/data/v1.json
!v1/backend/internal/news/vocabulary/data/reference-data/
!v1/backend/internal/news/vocabulary/data/reference-data/geography-2026-10-21.json
!v1/topics_extra.txt
!v1/web/nginx.conf

# Fixed backend vocabulary
!backend/internal/news/vocabulary/data/
!backend/internal/news/vocabulary/data/v1.json
!backend/internal/news/vocabulary/data/reference-data/
!backend/internal/news/vocabulary/data/reference-data/geography-2026-10-21.json

*.db
.idea
.vscode
.zed

# v1 pipeline: run results and caches
v1/out/
v1/cache/

# reasoning pipeline: run results, call logs, parsed Alfa theses
reasoning/out/*
!reasoning/out/U_9250.json
